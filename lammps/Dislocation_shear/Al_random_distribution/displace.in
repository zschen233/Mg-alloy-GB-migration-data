reset_timestep 0
change_box all y scale 1.1 boundary p p p triclinic
velocity mobile create 623.0 $(v_RN) rot yes dist gaussian
fix fixnpt all npt temp 623 623 $(100*dt) x 0 0 $(1000*dt) y 0 0 $(1000*dt) z 0 0 $(1000*dt) drag 1
run 20000
write_dump all custom model_swap0.lmp mass type xs ys zs c_Eatom

variable Eall0 equal $(c_Eall)
variable Emid0 equal $(c_Emid)
variable dEall equal c_Eall-v_Eall0
variable dEmid equal c_Emid-v_Emid0
print "strain stress(MPa) dEall(eV) dEmid(eV)" file stress_output.txt screen no
print "0.0 $(-pxy*0.1) $(v_dEall) $(v_dEmid)" append stress_output.txt screen no

variable i loop $(v_ndisp)
label loop_i
    displace_atoms upper move $(v_udisp) 0.0 0.0 units box
	displace_atoms mobile ramp x 0.0 $(v_udisp) y $(ylo+v_tsurf) $(yhi-v_tsurf) units box
    run $(v_nrelax)
	if "$(v_i%v_ndp) == 0" then &
	"write_dump all custom model_def$(v_i).lmp mass type xs ys zs c_Eatom"
	print "$(v_ustrain*v_i) $(-pxy*0.1) $(v_dEall) $(v_dEmid)" append stress_output.txt screen no
	next i
    jump SELF loop_i
label loop_end